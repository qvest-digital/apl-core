**values-repo.yaml
# Local lab credential dump written by SETUP.md step 9. Never commit this.
passwords.txt

# Root CA extracted from the live cluster by `task install:ca` (.taskfiles/install.yml) and
# deleted again by `task down`. Generated, never source -- and if it is ever staged, `down`
# leaves the index pointing at a file that no longer exists, which breaks the clean-context
# build (`git ls-files | tar` cannot stat it).
apl-root-ca.crt

# Taskfile.yml run state (derived MetalLB pool, APPS_REVISION, generated CA). Regenerated by
# `task cluster:metallb` / `task install:ca` every run; values.yaml itself stays out of this file
# on purpose -- see .git/info/exclude and CLAUDE.md's values.yaml trap.
.taskfiles/state/
